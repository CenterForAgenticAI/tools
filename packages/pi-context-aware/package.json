{
  "version": "0.5.11",
  "description": "Context-budget and compaction handoff support for pi: pressure markers, seed rewriting, proactive compaction, prior-session search, and context cache.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./context-service": {
      "types": "./dist/context-service.d.ts",
      "import": "./dist/context-service.js",
      "default": "./dist/context-service.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/folds/kernel/PROVENANCE.md', 'dist/folds/kernel/PROVENANCE.md')\" && node scripts/build-extension.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "lint": "eslint .",
    "test:compile": "rm -rf .test-dist && tsc -p tsconfig.test.json --pretty false",
    "test:run": "node scripts/with-temp-root.mjs node --test .test-dist/tests/*.test.js tests/*.test.mjs",
    "test": "npm run test:compile && npm run test:run",
    "test:unit": "npm test",
    "coverage": "npm run test:compile && node scripts/with-temp-root.mjs c8 node --test .test-dist/tests/*.test.js tests/*.test.mjs && npm run coverage:verify",
    "pi:check": "node scripts/check-pi-dependencies.mjs",
    "sdk:check": "node scripts/check-sdk-graph.mjs --lockfile --installed",
    "release:verify": "node scripts/check-sdk-graph.mjs --installed && npm test",
    "pi:compat": "node scripts/check-pi-compatibility.mjs",
    "check": "npm run build && npm run pi:check && npm run sdk:check && npm run typecheck && npm run lint && npm run test:hooks && npm run coverage && npm run test:safety-mutations:run && npm run exports:check && npm run pack:check",
    "ci": "npm run check",
    "hooks:install": "./scripts/install-git-hooks.sh",
    "test:hooks": "node scripts/with-temp-root.mjs sh scripts/test-autobuild-hooks.sh",
    "test:safety-mutations": "npm run test:compile && npm run test:safety-mutations:run",
    "test:safety-mutations:run": "node scripts/with-temp-root.mjs node tests/fixtures/safety/mutations.mjs",
    "bench:live": "npm run test:compile && node tests/bench-live.mjs",
    "bench:cache": "npm run test:compile && node tests/bench-cache-plan.mjs",
    "bench:recall": "npm run test:compile && node tests/bench-recall.mjs",
    "bench:replay": "npm run test:compile && node tests/bench-replay.mjs",
    "coverage:verify": "node scripts/with-temp-root.mjs node scripts/verify-cobertura.mjs",
    "exports:check": "node scripts/check-exports.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "name": "@centerforagenticai/pi-context-aware",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CenterForAgenticAI/tools.git",
    "directory": "packages/pi-context-aware"
  },
  "homepage": "https://github.com/CenterForAgenticAI/tools/tree/main/packages/pi-context-aware#readme",
  "bugs": {
    "url": "https://github.com/CenterForAgenticAI/tools/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "c8": "^11.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "typebox": "1.4.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "overrides": {
    "@earendil-works/chord": "$@earendil-works/pi-coding-agent",
    "@earendil-works/pi-agent-core": "$@earendil-works/pi-coding-agent",
    "@earendil-works/pi-ai": "$@earendil-works/pi-ai",
    "@earendil-works/pi-codemode": "$@earendil-works/pi-coding-agent",
    "@earendil-works/pi-coding-agent": "$@earendil-works/pi-coding-agent",
    "@earendil-works/pi-mcp": "$@earendil-works/pi-coding-agent",
    "@earendil-works/pi-telemetry": "$@earendil-works/pi-coding-agent",
    "@earendil-works/pi-tui": "$@earendil-works/pi-tui"
  }
}
