{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "index.ts",
    "compaction-ownership.ts",
    "compaction-history.ts",
    "config-layers.ts",
    "context-cache.ts",
    "context-service.ts",
    "context-telemetry.ts",
    "seed-expansion.ts",
    "peer-contracts.ts",
    "session-tasks*.ts",
    "worker-compaction-contract.ts",
    "workstream-*.ts"
  ]
}
