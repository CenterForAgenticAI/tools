{
  "name": "pi-anthropic-oauth",
  "version": "0.3.2-intel.1",
  "description": "Claude Pro/Max OAuth extension for Pi",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "UPSTREAM.json",
    "UPSTREAM.md",
    "SOURCE_MANIFEST.sha256"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leohenon/pi-anthropic-oauth"
  },
  "bugs": {
    "url": "https://github.com/leohenon/pi-anthropic-oauth/issues"
  },
  "homepage": "https://github.com/leohenon/pi-anthropic-oauth#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"require('node:fs').rmSync('.test-dist', { recursive: true, force: true })\" && tsc -p tsconfig.json --outDir .test-dist && node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check && npm test && npm run pack:check"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.86.0",
    "@earendil-works/pi-coding-agent": ">=0.86.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": ">=1.1.0",
    "@earendil-works/pi-coding-agent": ">=1.1.0",
    "typescript": "^5.9.3"
  }
}
