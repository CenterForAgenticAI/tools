{
  "version": "0.2.0",
  "description": "Wire protocol types and cursor helpers for Kleya clients; the Feed client and its IndexedDB cache are still empty.",
  "type": "module",
  "exports": {
    ".": {
      "kleya-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./protocol": {
      "kleya-source": "./src/protocol.ts",
      "types": "./lib/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./indexeddb": {
      "kleya-source": "./src/indexeddb.ts",
      "types": "./lib/indexeddb.d.ts",
      "default": "./lib/indexeddb.js"
    }
  },
  "files": [
    "src",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "sideEffects": false,
  "name": "@centerforagenticai/kleya-client",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CenterForAgenticAI/tools.git",
    "directory": "packages/kleya-client"
  },
  "homepage": "https://github.com/CenterForAgenticAI/tools/tree/main/packages/kleya-client#readme",
  "bugs": {
    "url": "https://github.com/CenterForAgenticAI/tools/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
