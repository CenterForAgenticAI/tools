{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "composite": true,
    "skipLibCheck": true,
    "paths": {
      "@caair/pi-daemon": ["./src/index.ts"],
      "@caair/pi-daemon/client": ["./src/client/index.ts"],
      "@caair/pi-daemon/protocol": ["./src/protocol/index.ts"],
      "@caair/pi-daemon/testing": ["./src/testing/gate-provider.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["test/fixtures/strict-consumer"]
}
