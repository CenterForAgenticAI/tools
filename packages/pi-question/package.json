{
  "version": "0.1.0",
  "description": "Structured human questions for pi that work in the TUI, headless hosts such as pi-daemon, and delegate workers. Registers an ask tool compatible with pi-ask-tool and exports the question contract.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "exports": {
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:coverage": "c8 node --test \"tests/**/*.test.ts\"",
    "test:public": "npm test && npm run smoke:package",
    "smoke:package": "node scripts/smoke-package.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run smoke:package",
    "hooks:install": "node scripts/install-hooks.mjs",
    "proof": "bend PROOF.bend"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "name": "@centerforagenticai/pi-question",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CenterForAgenticAI/tools.git",
    "directory": "packages/pi-question"
  },
  "homepage": "https://github.com/CenterForAgenticAI/tools/tree/main/packages/pi-question#readme",
  "bugs": {
    "url": "https://github.com/CenterForAgenticAI/tools/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "c8": "^11.0.0",
    "eslint": "^10.7.0",
    "globals": "^16.0.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "typebox": "^1.3.27"
  }
}
