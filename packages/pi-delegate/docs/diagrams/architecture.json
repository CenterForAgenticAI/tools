    { "id": "workers", "label": "Worker sessions", "sublabel": "solo, supervised, chain", "kind": "accent" },
    { "id": "daemon", "label": "pi-daemon", "sublabel": "durable driver host", "kind": "external" },
    { "id": "state", "label": "Run state", "sublabel": "bounded local records", "kind": "store" }
  ],
  "edges": [
